# botville 环境变量示例 —— 只放占位符，真实值写进本地 .env（已被 .gitignore 忽略）
# Copy to .env and fill in locally. NEVER commit real values.

# 服务器选择 / homeserver: synapse | tuwunel | continuwuity
BOTVILLE_HOMESERVER=synapse
BOTVILLE_SERVER_NAME=example.invalid
BOTVILLE_PUBLIC_URL=https://example.invalid

# Postgres（Synapse 用）
POSTGRES_USER=botville
POSTGRES_PASSWORD=<change-me>
POSTGRES_DB=synapse

# appservice（网关）
APPSERVICE_AS_TOKEN=<change-me>
APPSERVICE_HS_TOKEN=<change-me>

# 网关（gateway）
# GATEWAY_AUTH_TOKEN：调用方 bearer token，非 dev 模式必填。
GATEWAY_AUTH_TOKEN=<change-me>
# GATEWAY_HMAC_SECRET：txnId / text_sha256 的 HMAC 密钥。
# **只接受 hex，至少 64 个 hex 字符（= 32 字节），拒绝全零**。
# 生成：python3 -c 'import secrets;print(secrets.token_hex(32))'
GATEWAY_HMAC_SECRET=<change-me>

# 可选模块开关

# 模型 API（可多个，可替换）
LLM_PROVIDER=deepseek
LLM_BASE_URL=<provider-base-url>
LLM_API_KEY=<change-me>

# 推送 / Sygnal + APNs
APNS_TEAM_ID=<team-id>
APNS_KEY_ID=<key-id>
APNS_KEY_PATH=./secrets/apns.p8
APNS_TOPIC=<bundle-id>

# 授权回调签名
AUTH_CALLBACK_SIGNING_KEY=<change-me>

# 可选模块开关
BOTVILLE_MODULES=core,role,memory,social,notify
TOWN_ENABLED=false
TOWN_TICK_SECONDS=2
