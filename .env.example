# botville 环境变量示例 —— 只放占位符，真实值写进本地 .env（已被 .gitignore 忽略）
# Copy to .env and fill in locally. NEVER commit real values.

# 服务器选择 / homeserver: synapse | tuwunel | continuwuity
BOTVILLE_HOMESERVER=synapse
BOTVILLE_SERVER_NAME=example.invalid
BOTVILLE_PUBLIC_URL=https://example.invalid

# Postgres（Synapse 用）
POSTGRES_USER=botville
POSTGRES_PASSWORD=<change-me>
POSTGRES_DB=synapse

# appservice（网关）
APPSERVICE_AS_TOKEN=<change-me>
APPSERVICE_HS_TOKEN=<change-me>

# 网关（gateway）
# GATEWAY_AUTH_TOKEN：调用方 bearer token，非 dev 模式必填。
GATEWAY_AUTH_TOKEN=<change-me>
# GATEWAY_HMAC_SECRET：txnId / text_sha256 的 HMAC 密钥。
# **只接受 hex，至少 64 个 hex 字符（= 32 字节），拒绝全零**。
# 生成：python3 -c 'import secrets;print(secrets.token_hex(32))'
GATEWAY_HMAC_SECRET=<change-me>

# 网关 persona 情绪（B 线 PR4b）与 AI 主动发言（B 线 PR4c），默认全关；
# 与 gateway/.env.example 一致。情绪依赖 GATEWAY_MEMORY_DB_PATH（记忆库）。
# 开启 GATEWAY_PROACTIVE_ENABLED 前必须先启用记忆库（GATEWAY_MEMORY_DB_PATH），
# 并配置持久的 GATEWAY_HMAC_SECRET（重启不变；没有显式值网关拒绝启动）。
# 半衰期 1–10080 分钟；调度间隔 30–86400 秒；空闲 / 间隔 0–43200 分钟；
# 每目标每日上限 0–24（0 = 不发送）。
GATEWAY_MOOD_ENABLED=false
GATEWAY_MOOD_HALF_LIFE_MINUTES=240
GATEWAY_PROACTIVE_ENABLED=false
GATEWAY_PROACTIVE_RECENT_CONTACTS_ENABLED=false
GATEWAY_PROACTIVE_TICK_SECONDS=300
GATEWAY_PROACTIVE_MIN_IDLE_MINUTES=180
GATEWAY_PROACTIVE_MIN_INTERVAL_MINUTES=240
GATEWAY_PROACTIVE_PER_TARGET_PER_DAY=1

# 模型 API（可多个，可替换）
LLM_PROVIDER=deepseek
LLM_BASE_URL=<provider-base-url>
LLM_API_KEY=<change-me>

# 推送 / Sygnal + APNs
# BOTVILLE_APNS_BUNDLE_ID：iOS Bundle ID（反向域名）。APNS_TOPIC 默认等于它，
# APNS_APP_ID 默认推导为 "<bundle-id>.apns"（单 app 约定，issue #4）。
BOTVILLE_APNS_BUNDLE_ID=<bundle-id>
# BOTVILLE_PUSH_DOMAIN：推送公网域名（仅 BOTVILLE_PUSH_PUBLIC=true 时需要：
# 反代 push.<domain> → 127.0.0.1:8019，App 端 pusher 的 data.url 用
# https://<BOTVILLE_PUSH_DOMAIN>/_matrix/push/v1/notify）。
BOTVILLE_PUSH_DOMAIN=<push-domain>
# BOTVILLE_PUSH_PUBLIC：#128 决策，默认 false = 不对外暴露 push 域名，
# homeserver 走 compose 内网 http://sygnal:5000；true 才按
# docs/deploy/push-sygnal.md §12 的反代示例开放公网网关。
BOTVILLE_PUSH_PUBLIC=false
APNS_TEAM_ID=<team-id>
APNS_KEY_ID=<key-id>
APNS_KEY_PATH=./secrets/apns.p8
APNS_TOPIC=<bundle-id>

# 授权回调签名
AUTH_CALLBACK_SIGNING_KEY=<change-me>

# 可选模块开关
BOTVILLE_MODULES=core,role,memory,social,notify
TOWN_ENABLED=false
TOWN_TICK_SECONDS=2
