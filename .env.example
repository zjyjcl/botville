# botville 环境变量示例 —— 只放占位符，真实值写进本地 .env（已被 .gitignore 忽略）
# Copy to .env and fill in locally. NEVER commit real values.

# 服务器选择 / homeserver: synapse | tuwunel | continuwuity
BOTVILLE_HOMESERVER=synapse
BOTVILLE_SERVER_NAME=example.invalid
BOTVILLE_PUBLIC_URL=https://example.invalid

# Postgres（Synapse 用）
POSTGRES_USER=botville
POSTGRES_PASSWORD=<change-me>
POSTGRES_DB=synapse

# appservice（网关）
APPSERVICE_AS_TOKEN=<change-me>
APPSERVICE_HS_TOKEN=<change-me>

# 网关（gateway）
# GATEWAY_AUTH_TOKEN：调用方 bearer token，非 dev 模式必填。
GATEWAY_AUTH_TOKEN=<change-me>
# GATEWAY_HMAC_SECRET：txnId / text_sha256 的 HMAC 密钥。
# **只接受 hex，至少 64 个 hex 字符（= 32 字节），拒绝全零**。
# 生成：python3 -c 'import secrets;print(secrets.token_hex(32))'
GATEWAY_HMAC_SECRET=<change-me>

# 配对服务（A-R4 / #8，make up PAIRING=1）。三个 token 必须两两不同，init.sh 自动生成：
# PAIRING_ADMIN_TOKEN 只管管理接口；PAIRING_SERVICE_TOKEN 只读配对事实（/v1/pairing/internal/*）；
# PAIRING_RELATIONS_SEND_TOKEN 只用于跨服关系发送（/v1/pairing/internal/relations/*），至少 32 字符。
# 根目录与 server/compose 的 .env.example 保持一致；网关侧接收这两个 token 的变量名由 B 线在
# gateway/.env.example 已按 #257 对齐，见下方可选 HTTP 接线。
PAIRING_ADMIN_TOKEN=<change-me>
PAIRING_SERVICE_TOKEN=<change-me>
PAIRING_RELATIONS_SEND_TOKEN=<change-me>

# App 扫码兑换（A-R7 / #128，可选 profile pair-redeem，默认关闭）。
# make up 不会启动该服务，也不需要 Synapse admin token。
# 显式启用：make up HS=synapse PAIR_REDEEM=1，并设置
# BOTVILLE_PAIR_REDEEM_SYNAPSE_ADMIN_TOKEN 为 Synapse 管理员 access token
# （init.sh 不会生成；随机 hex 不是 Synapse token）。宿主机端口只绑 127.0.0.1。
# 这不是联邦 /v1/pairing/redeem，也不会打开配对入站或 relations 桥。
BOTVILLE_PAIR_REDEEM_PORT=8092
BOTVILLE_PAIR_REDEEM_SYNAPSE_URL=http://synapse:8008
BOTVILLE_PAIR_REDEEM_SYNAPSE_ADMIN_TOKEN=
BOTVILLE_PAIR_REDEEM_TRUSTED_PROXIES=
# 可选管理签发（A-R9 / #128）。默认关闭：留空则 POST /_botville/pair/issue
# 返回 404。显式启用时填至少 32 个字符，且必须不同于上面的 Synapse
# admin token。init.sh 不会生成。请求需 Authorization: Bearer。
# 此路径永远不得暴露到公共 edge，也不可无鉴权签发。不要把真实 token
# 或签发得到的 URI/兑换码写入仓库或日志。
BOTVILLE_PAIR_REDEEM_ISSUE_TOKEN=

# 可选 HTTPS edge（A-R8 / #128，profile pair-redeem-edge，默认关闭）。
# make up 不会启动它，也不要求证书或公网域名。显式启用：
# make up HS=synapse PAIR_REDEEM=1 PAIR_REDEEM_EDGE=1，并在
# BOTVILLE_PAIR_REDEEM_EDGE_CERT_DIR 放入 cert.pem 与 key.pem
# （init.sh 不会生成；本地/自签证书不能代替公网 HTTPS 或真机扫码）。
# 宿主机端口只绑 127.0.0.1。Caddy 监听 :8443（不按主机名分流）。
# 面向 App/公网的 hs、gw 请用 https://，示例域名只用 example.org。
# 管理签发见上方 BOTVILLE_PAIR_REDEEM_ISSUE_TOKEN，默认关闭，不得暴露到公共 edge。
# 若要把限速键改成「edge 前面那一跳」，把
# BOTVILLE_PAIR_REDEEM_TRUSTED_PROXIES 设为 edge 的固定 IP/CIDR。
# 这只在 edge 是首跳（客户端直接连 edge）时，才会把真实客户端当作
# XFF 最后一跳。若前面还有公网/隧道反代，Caddy 默认会用直连对端覆盖
# 客户端自报的 XFF；即便在 edge 上配 trusted_proxies 把前置 XFF 传下去，
# pair_redeem 仍取最后一个 hop，得到的是前置反代而不是手机/真实用户，
# 限速仍是「每隧道一个桶」。留空则限速按 edge 自身计，IP_LIMIT 实际
# 变成全局桶。不要把空默认改成需要真实公网地址的值。
BOTVILLE_PAIR_REDEEM_EDGE_PORT=8443
BOTVILLE_PAIR_REDEEM_EDGE_CERT_DIR=./generated/pair-redeem-edge

# 网关 persona 情绪（B 线 PR4b）与 AI 主动发言（B 线 PR4c），默认全关；
# 三份 .env.example（根目录、server/compose、gateway）保持一致。情绪依赖 GATEWAY_MEMORY_DB_PATH（记忆库）。
# 开启 GATEWAY_PROACTIVE_ENABLED 前必须先启用记忆库（GATEWAY_MEMORY_DB_PATH），
# 并配置持久的 GATEWAY_HMAC_SECRET（重启不变；没有显式值网关拒绝启动）。
# 半衰期 1–10080 分钟；调度间隔 30–86400 秒；空闲 / 间隔 0–43200 分钟；
# 每目标每日上限 0–24（0 = 不发送）。
GATEWAY_MOOD_ENABLED=false
GATEWAY_MOOD_HALF_LIFE_MINUTES=240
GATEWAY_PROACTIVE_ENABLED=false
GATEWAY_PROACTIVE_RECENT_CONTACTS_ENABLED=false
GATEWAY_PROACTIVE_TICK_SECONDS=300
GATEWAY_PROACTIVE_MIN_IDLE_MINUTES=180
GATEWAY_PROACTIVE_MIN_INTERVAL_MINUTES=240
GATEWAY_PROACTIVE_PER_TARGET_PER_DAY=1
# 每条群聊人类消息最多几个 AI 回复（B 线 B2.8a）；整数 1–20，默认 3，私聊不受影响；
# 超出范围网关拒绝启动。三份 .env.example 保持一致。
GATEWAY_GROUP_MAX_RESPONDERS=3

# 网关群邀请（B 线 B2.8b），默认关闭；三份 .env.example（根目录、server/compose、
# gateway）保持一致。开启 GATEWAY_GROUPS_ENABLED 需要记忆库（GATEWAY_MEMORY_DB_PATH）、
# persona 的 groups.enabled，以及持久的 GATEWAY_HMAC_SECRET：不能清空、不能重新生成，
# 轮换它会让已接受的群全部失效。每 persona 群数 1–200（默认 20）；邀请台账过期
# 60–2592000 秒（默认 86400）。
GATEWAY_GROUPS_ENABLED=false
GATEWAY_GROUP_MAX_ROOMS_PER_PERSONA=20
GATEWAY_INVITE_LEDGER_TTL_SECONDS=86400

# 网关群节流（B 线 B2.8c）；三份 .env.example 保持一致。节流计数在进程内存里，网关重启后清零。
# GATEWAY_GROUP_FORGET_STALE_KEYS：轮换 HMAC 密钥后由运维一次性打开的清理开关（严格布尔，默认 false）。
# 打开期间每次启动都会永久删除旧 key_id 的群台账（解除轮换隔离，旧 left / encrypted_disabled
# 记录丢失，被踢或已退出的群收到新邀请可能再次加入）；打开、重启一次后改回 false。
# （这段注释须紧挨 GATEWAY_GROUP_FORGET_STALE_KEYS= 那一行之上，测试只检查紧邻的注释块。）
# 冷却 0–3600 秒（0 = 关）；每小时回复 1–200；整群 AI 循环每小时 1–1000；连续 AI 消息 1–50。
GATEWAY_GROUP_FORGET_STALE_KEYS=false
GATEWAY_GROUP_COOLDOWN_SECONDS=30
GATEWAY_GROUP_MAX_REPLIES_PER_HOUR=20
GATEWAY_GROUP_AI_LOOP_MAX_PER_HOUR=30
GATEWAY_GROUP_MAX_CONSECUTIVE_AI_MESSAGES=3

# 模型 API（可多个，可替换）
LLM_PROVIDER=deepseek
LLM_BASE_URL=<provider-base-url>
LLM_API_KEY=<change-me>

# 推送 / Sygnal + APNs
# BOTVILLE_APNS_BUNDLE_ID：iOS Bundle ID（反向域名）。APNS_TOPIC 默认等于它，
# APNS_APP_ID 默认推导为 "<bundle-id>.apns"（单 app 约定，issue #4）。
BOTVILLE_APNS_BUNDLE_ID=<bundle-id>
# BOTVILLE_PUSH_DOMAIN：推送公网域名（仅 BOTVILLE_PUSH_PUBLIC=true 时需要：
# 反代 push.<domain> → 127.0.0.1:8019，App 端 pusher 的 data.url 用
# https://<BOTVILLE_PUSH_DOMAIN>/_matrix/push/v1/notify）。
BOTVILLE_PUSH_DOMAIN=<push-domain>
# BOTVILLE_PUSH_PUBLIC：#128 决策，默认 false = 不对外暴露 push 域名，
# homeserver 走 compose 内网 http://sygnal:5000；true 才按
# docs/deploy/push-sygnal.md §12 的反代示例开放公网网关。
BOTVILLE_PUSH_PUBLIC=false
APNS_TEAM_ID=<team-id>
APNS_KEY_ID=<key-id>
APNS_KEY_PATH=./secrets/apns.p8
APNS_TOPIC=<bundle-id>

# 授权回调签名
AUTH_CALLBACK_SIGNING_KEY=<change-me>

# 可选模块开关
BOTVILLE_MODULES=core,role,memory,social,notify
TOWN_ENABLED=false
TOWN_TICK_SECONDS=2

# Optional cross-server relations (#257). Disabled unless explicitly configured.
# Container setup: BIND=0.0.0.0:8091 (container network ONLY; no host port),
# PAIRING_RELATIONS_GATEWAY=http, PAIRING_RELATIONS_GATEWAY_URL=http://gateway:8091,
# GATEWAY_PAIRING_RELATIONS_URL=http://pairing:8090. Start both profiles.
# BIND empty => no listener. URL empty => gateway outbound worker disabled.
# Host-side setup: use 127.0.0.1 and distinct ports; never expose /_internal.
# The inbound token authenticates pairing -> gateway; the existing send token
# authenticates gateway -> pairing. Keep them distinct and never print values.
GATEWAY_RELATIONS_INBOUND_BIND=
GATEWAY_RELATIONS_INBOUND_TOKEN=<change-me>
GATEWAY_PAIRING_RELATIONS_URL=
PAIRING_RELATIONS_GATEWAY_URL=
PAIRING_RELATIONS_GATEWAY=none
