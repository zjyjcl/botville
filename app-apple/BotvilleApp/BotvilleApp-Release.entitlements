<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.$(BOTVILLE_BUNDLE_ID_PREFIX)</string>
    </array>
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)$(BOTVILLE_BUNDLE_ID_PREFIX)</string>
        <string>$(AppIdentifierPrefix)$(BOTVILLE_BUNDLE_ID_PREFIX).shared</string>
    </array>
</dict>
</plist>
