# Botville server stack configuration.
#
# server/scripts/init.sh copies this to server/compose/.env (gitignored) on
# first run and replaces every <change-me> with a locally generated random
# value (openssl rand -hex 32). Only placeholders ship in this file; never
# commit real secrets here.

# Which homeserver `make up` starts: synapse | tuwunel | continuwuity.
# CI overrides this per matrix leg; `make up HS=tuwunel` overrides it ad hoc.
BOTVILLE_HOMESERVER=synapse
BOTVILLE_SERVER_NAME=localhost
BOTVILLE_HTTP_PORT=8008
# Synapse-only: open registration (m.login.dummy) for local experiments.
# tuwunel/continuwuity are always token-gated regardless of this flag.
BOTVILLE_OPEN_REGISTRATION=false
# Shared registration token for tuwunel/continuwuity (and future appservice
# bootstrap). Note: on continuwuity this stays invalid until the first account
# exists — see BOTVILLE_ADMIN_* below and bootstrap-continuwuity.sh.
BOTVILLE_REGISTRATION_TOKEN=<change-me>

# Bootstrap admin account for continuwuity's first boot: on a userless
# database the one-time token printed in the container logs registers this
# account as the first user, which becomes the server admin.
BOTVILLE_ADMIN_USER=botville-admin
BOTVILLE_ADMIN_PASSWORD=<change-me>

# Synapse + Postgres.
POSTGRES_USER=botville
POSTGRES_PASSWORD=<change-me>
POSTGRES_DB=synapse

# Synapse secrets (random-generated by init.sh).
SYNAPSE_MACAROON_SECRET=<change-me>
SYNAPSE_FORM_SECRET=<change-me>
SYNAPSE_REGISTRATION_SHARED_SECRET=<change-me>

# Image overrides. Defaults mirror docker-compose.yml: every image is pinned
# to tag@sha256 digest (see docs/ops/upgrade-images.md before changing them).
# Overriding to :latest to track upstream is possible but not recommended.
POSTGRES_IMAGE=docker.io/library/postgres:16-alpine@sha256:0cefaabd882e42bcb2a2f3dc56d3ce4770560ba62fd7f197f1a2e008fd5731ab
SYNAPSE_IMAGE=docker.io/matrixdotorg/synapse:v1.141.0@sha256:562adbfc3df12d1024c7277b9807086ed79d8d5fabe24187a31d787af050a6a4
TUWUNEL_IMAGE=ghcr.io/matrix-construct/tuwunel:v1.9.4@sha256:0e86c6164d6c9f5b60291938eb61ad8395021c37fe58d47a963ea7edddbedaec
CONTINUWUITY_IMAGE=ghcr.io/continuwuity/continuwuity:v26.9.1@sha256:c9c62bc5c0a641f3f713945c701b069c7bc30d2612b54d4a5de80a5be19d5420
