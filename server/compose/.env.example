# Botville server stack configuration.
#
# server/scripts/init.sh copies this to server/compose/.env (gitignored) on
# first run and replaces every <change-me> with a locally generated random
# value (openssl rand -hex 32). Only placeholders ship in this file; never
# commit real secrets here.

# Which homeserver `make up` starts: synapse | tuwunel | continuwuity.
# CI overrides this per matrix leg; `make up HS=tuwunel` overrides it ad hoc.
BOTVILLE_HOMESERVER=synapse
BOTVILLE_SERVER_NAME=localhost
BOTVILLE_HTTP_PORT=8008
# Synapse-only: open registration (m.login.dummy) for local experiments.
# tuwunel/continuwuity are always token-gated regardless of this flag.
BOTVILLE_OPEN_REGISTRATION=false
# Shared registration token for tuwunel/continuwuity (and future appservice
# bootstrap). Note: on continuwuity this stays invalid until the first account
# exists — see BOTVILLE_ADMIN_* below and bootstrap-continuwuity.sh.
BOTVILLE_REGISTRATION_TOKEN=<change-me>

# Bootstrap admin account for continuwuity's first boot: on a userless
# database the one-time token printed in the container logs registers this
# account as the first user, which becomes the server admin.
BOTVILLE_ADMIN_USER=botville-admin
BOTVILLE_ADMIN_PASSWORD=<change-me>
# Compose project name: prefixes every container/volume/network of this stack
# (e.g. <project>_synapse-data). Each instance/checkout on the same machine
# needs a unique project AND a unique BOTVILLE_HTTP_PORT, or compose treats
# them as one stack (down -v on one wipes the other's volumes). make and the
# backup/restore scripts pass -p with this value automatically.
COMPOSE_PROJECT_NAME=botville
# Docker network of this stack (RFC1918 IPv4, prefix /24 or longer, no host
# bits — init.sh validates and refuses friendly otherwise). Each instance on
# one machine needs its own subnet too (e.g. botville 172.31.250.0/24,
# botville-zcode 172.31.251.0/24, botville-codex 172.31.252.0/24).
BOTVILLE_DOCKER_SUBNET=172.31.250.0/24
# Dynamic-address pool of that network (compose `ipam.ip_range`), must sit
# inside BOTVILLE_DOCKER_SUBNET. Docker allocates dynamically starting at
# the subnet's .2, which would collide with the sygnal container's fixed
# .2 below; the pool keeps dynamic addresses in .64-.127 so the fixed one is
# never contested. Adjust alongside the subnet for multi-instance setups
# (e.g. 172.31.251.64/26).
BOTVILLE_DOCKER_IP_RANGE=172.31.250.64/26
# Fixed IPv4 of the sygnal container inside that subnet (the network's .2 by
# convention; compose assigns it via ipv4_address). This single /32 is the
# ONLY private range the homeservers may send push to — Synapse's
# ip_range_whitelist and the tuwunel/continuwuity denylist carve-out cover
# exactly it, nothing else (on Synapse that whitelist also governs URL
# previews, remote media and federation). Must sit inside
# BOTVILLE_DOCKER_SUBNET, outside BOTVILLE_DOCKER_IP_RANGE, and must not be
# the network, gateway (.1) or broadcast address. Leave EMPTY to allow no
# private range at all (full upstream default denylist, no Synapse whitelist)
# — for production where sygnal is reached on a public HTTPS domain.
BOTVILLE_SYGNAL_IP=172.31.250.2

# Append-only additions to the compose stack's fixed NO_PROXY/no_proxy list
# (issue #134): docker injects the host's HTTP(S)_PROXY into every new
# container, where 127.0.0.1 is the container itself, so in-stack traffic
# (e.g. Synapse -> http://sygnal:5000) must bypass any proxy. The default
# list (docker-compose.yml x-noproxy-env: all in-stack service names +
# loopback + RFC1918 ranges) is NOT overridable; set this only to append
# names a container must also reach directly (e.g. a registry mirror or
# another compose network's service). Comma-separated, no leading comma;
# empty (default) = defaults only, and never leaves a trailing comma.
BOTVILLE_NO_PROXY_EXTRA=

# Push gateway (A1.2, sygnal). `make up PUSH=1` adds the `push` profile;
# homeservers reach sygnal inside the compose network, the port below is a
# loopback-only host mapping for manual poking / server/tests/push_e2e.py.
BOTVILLE_PUSH_PORT=8019
# Include the org.botville.mock test pushkin in the generated sygnal.yaml
# (true/1/yes; default true — make push-e2e / CI rely on it). It only ever
# writes JSONL records under generated/. Set false for a production sygnal
# serving just the real APNs app; with both apps off sygnal has no apps,
# init.sh prints a WARNING and sygnal v0.17 refuses to start ("No app IDs
# are configured") — never turn both off at once.
BOTVILLE_PUSH_MOCK=true

# Real APNs (iOS). Disabled by default: BOTVILLE_APNS_ENABLED=true only turns
# on once BOTVILLE_APNS_BUNDLE_ID/APNS_KEY_ID/APNS_TEAM_ID are real values (no
# <placeholders>) AND a real server/compose/secrets/apns.p8 exists (non-empty,
# mode 600/400) — init.sh then renders the APNs app into
# generated/sygnal/sygnal.yaml; until then only the org.botville.mock pushkin
# (CI/local latency tests) is configured. Values that are present but
# malformed (Key/Team ID not 10 uppercase alphanumerics, bundle id not reverse
# domain, wrong platform, key file too permissive) make init.sh exit 1. No real
# Apple values ever ship in this file. See docs/deploy/push-sygnal.md.
BOTVILLE_APNS_ENABLED=false
# iOS Bundle ID (reverse-domain, the app's PRODUCT_BUNDLE_IDENTIFIER).
# APNS_TOPIC defaults to it, and APNS_APP_ID to "<bundle-id>.apns" — both may
# stay placeholders here and are derived by init.sh (single-app convention,
# issue #4); an explicit APNS_APP_ID must equal "<bundle-id>.apns" exactly.
BOTVILLE_APNS_BUNDLE_ID=<bundle-id>
APNS_APP_ID=<bundle-id>.apns
APNS_TOPIC=<bundle-id>
APNS_KEY_ID=<key-id>
APNS_TEAM_ID=<team-id>
# sandbox | production (sandbox for development builds); switch by editing
# this value and re-running `make up PUSH=1` (single-app plan, issue #4).
APNS_PLATFORM=sandbox
# Public domain the push gateway is reverse-proxied on (push.<domain>); only
# consumed in the optional BOTVILLE_PUSH_PUBLIC=true mode below, where the
# app registers its pusher with data.url https://<BOTVILLE_PUSH_DOMAIN>/
# _matrix/push/v1/notify. Informatory for operators — nothing in the compose
# stack consumes it mechanically. See docs/deploy/push-sygnal.md (8845 mini PC
# deployment).
BOTVILLE_PUSH_DOMAIN=<push-domain>
# Issue #128 decision: push.<domain> is NOT exposed publicly by default.
# false (default): homeservers reach sygnal inside the compose network
# (http://sygnal:5000, allowed as the BOTVILLE_SYGNAL_IP /32 carve-out) and
# no public reverse proxy is deployed. true: expose the gateway behind a
# reverse proxy on BOTVILLE_PUSH_DOMAIN (examples in docs/deploy/
# push-sygnal.md §12 are for this mode only) — only needed when the
# homeserver cannot reach sygnal in-network. Operator-facing switch; the
# compose stack itself does not consume it either.
BOTVILLE_PUSH_PUBLIC=false

# Synapse + Postgres.
POSTGRES_USER=botville
POSTGRES_PASSWORD=<change-me>
POSTGRES_DB=synapse

# Synapse secrets (random-generated by init.sh).
SYNAPSE_MACAROON_SECRET=<change-me>
SYNAPSE_FORM_SECRET=<change-me>
SYNAPSE_REGISTRATION_SHARED_SECRET=<change-me>

# Appservice registration for the botville AI gateway (A1.3). init.sh renders
# both into server/compose/generated/appservice/botville-gateway.yaml
# (gitignored, 0600). as_token: what the gateway presents to act as any @ai_*
# user (masquerade + namespace registration); compose injects this same value
# as GATEWAY_AS_TOKEN (do not invent a second token). hs_token: what the
# homeserver will present when pushing AS transactions to the gateway; compose
# injects this same value as GATEWAY_HS_TOKEN (must differ from as_token).
# The registration url is http://gateway:8080 only for `make up GATEWAY=1` on
# synapse/tuwunel, null otherwise (init.sh renders it). Synapse reads the
# file via app_service_config_files, tuwunel via TUWUNEL_APPSERVICE_DIR;
# continuwuity is not wired up yet (see docs/deploy/appservice.md).
APPSERVICE_AS_TOKEN=<change-me>
APPSERVICE_HS_TOKEN=<change-me>

# Botville gateway service (A2.2 / #7), optional `gateway` profile:
# `make up GATEWAY=1` (any HS). Loopback-only host port of the gateway HTTP
# API (container port 8080). The two secrets below are generated by init.sh
# (<change-me> -> openssl rand -hex 32, i.e. 64 hex chars) and handed to the
# container as GATEWAY_AUTH_TOKEN / GATEWAY_HMAC_SECRET; the gateway refuses
# to start with empty or placeholder values. They live only in .env, never in
# the gateway-data volume or the image.
BOTVILLE_GATEWAY_PORT=8020
BOTVILLE_GATEWAY_AUTH_TOKEN=<change-me>
BOTVILLE_GATEWAY_HMAC_SECRET=<change-me>

# Gateway persona engine (B line PR2; consumer from PR1), passed through to the
# gateway service as-is. init.sh generates NONE of these (empty stays empty).
# An AI only speaks when GATEWAY_CONSUMER_ENABLED=true AND a model
# (GATEWAY_MODEL_BASE_URL + GATEWAY_MODEL_NAME) AND personas
# (GATEWAY_PERSONAS_FILE) are configured; otherwise it records and stays quiet.
# GATEWAY_MODEL_BASE_URL: OpenAI-compatible endpoint; empty = no model.
# GATEWAY_MODEL_API_KEY: put the real key only in your local .env (never in
# the repo, chat or logs). Do not paste `docker compose config` output: it
# prints interpolated values; use `docker compose config --quiet`.
# GATEWAY_PERSONAS_FILE: empty = no personas; set it to
# /etc/botville-gateway/personas.json after placing a real personas.json in
# server/compose/gateway-personas/ (bind-mounted read-only; real files are
# gitignored). BOTVILLE_GATEWAY_PERSONAS_DIR (unset here) swaps that host dir.
# Changes take effect on the next `make up GATEWAY=1` (container recreated).
GATEWAY_CONSUMER_ENABLED=false
# GATEWAY_GROUP_MAX_RESPONDERS: at most this many AIs answer one human group
# message (B line B2.8a); integer 1-20, default 3; DMs are not affected. Any
# other value makes the gateway refuse to start.
GATEWAY_GROUP_MAX_RESPONDERS=3
# Group invites (B line B2.8b), passed through as-is; init.sh generates none.
# The three .env.example files (repo root, server/compose, gateway) agree.
# GATEWAY_GROUPS_ENABLED: true | false (default off; strict boolean). Turning
# it on needs GATEWAY_MEMORY_DB_PATH, personas with groups.enabled and a
# PERSISTENT HMAC secret: BOTVILLE_GATEWAY_HMAC_SECRET above -- never empty
# it or regenerate it; rotating it invalidates every accepted group.
# GATEWAY_GROUP_MAX_ROOMS_PER_PERSONA: integer 1-200 (default 20).
# GATEWAY_INVITE_LEDGER_TTL_SECONDS: integer 60-2592000 (default 86400);
# expired invites are confirmed via /sync instead of the ledger fast path.
GATEWAY_GROUPS_ENABLED=false
GATEWAY_GROUP_MAX_ROOMS_PER_PERSONA=20
GATEWAY_INVITE_LEDGER_TTL_SECONDS=86400
GATEWAY_MODEL_BASE_URL=
GATEWAY_MODEL_NAME=
GATEWAY_MODEL_API_KEY=
GATEWAY_MODEL_TIMEOUT_SECONDS=30
GATEWAY_PERSONAS_FILE=

# Gateway four-layer memory (B line PR3a), passed through as-is; init.sh
# generates none of these. GATEWAY_MEMORY_DB_PATH empty = memory off (the
# engine keeps its in-process ring buffer). To enable, set it to
# /var/lib/botville-gateway/memory.db -- the top level of the gateway-data
# volume, so `make backup` checkpoints its WAL and archives it and
# `make restore` brings it back (as 0600). The gateway creates the file 0600 (it holds
# chat text and profiles; keep backups private).
# GATEWAY_MEMORY_RETENTION_DAYS: >= 1 (pinned items never expire).
# GATEWAY_MEMORY_PURGE_INTERVAL_SECONDS: 0 = no purge, otherwise >= 60.
GATEWAY_MEMORY_DB_PATH=
GATEWAY_MEMORY_RETENTION_DAYS=90
GATEWAY_MEMORY_PURGE_INTERVAL_SECONDS=86400

# Idle memory upkeep (B line PR3b): rolling summaries, fact extraction and
# vector recall. Passed through as-is; init.sh generates none of these.
# GATEWAY_MEMORY_SUMMARY_MODEL: empty = reuse GATEWAY_MODEL_NAME.
# GATEWAY_EMBEDDING_MODEL: empty = layer 4 (vector recall) off.
# PRIVACY: once GATEWAY_EMBEDDING_MODEL is set, chat text -- private chats
# included -- is sent to the embedding provider. With
# GATEWAY_EMBEDDING_BASE_URL empty that is the chat model's endpoint, i.e.
# the same provider as GATEWAY_MODEL_BASE_URL.
# GATEWAY_EMBEDDING_BASE_URL: empty = reuse GATEWAY_MODEL_BASE_URL.
# GATEWAY_EMBEDDING_API_KEY: secret; empty = reuse GATEWAY_MODEL_API_KEY. Put
# a real key only in your local .env (never in the repo, chat or logs).
# GATEWAY_EMBEDDING_DIM: 0 = take the first response's dimension.
# GATEWAY_MEMORY_VECTOR_BACKEND: none | python | sqlite-vec (falls back to
# python when the extension cannot load).
GATEWAY_MEMORY_SUMMARY_MODEL=
GATEWAY_EMBEDDING_BASE_URL=
GATEWAY_EMBEDDING_MODEL=
GATEWAY_EMBEDDING_API_KEY=
GATEWAY_EMBEDDING_DIM=0
GATEWAY_MEMORY_VECTOR_BACKEND=python

# Owner reads DM memory (B line PR3d), passed through as-is; init.sh does not
# generate it. false (default) = the AI's owner can manage its memory but DM
# text and fact values stay redacted. true = the owner can read the AI's
# private-chat memory, and the App shows a disclosure to the people chatting
# with that AI. Strict boolean: true/false (also 1/0, yes/no, on/off); any
# other value makes the gateway refuse to start.
GATEWAY_MEMORY_OWNER_CAN_READ_DM=false

# Persona mood (B line PR4b) and proactive speech (B line PR4c), passed
# through as-is; init.sh generates none of these. The three .env.example
# files (repo root, server/compose, gateway) agree.
# GATEWAY_MOOD_ENABLED: true | false (default off); needs GATEWAY_MEMORY_DB_PATH
# (without it mood stays off and the gateway logs a warning).
# GATEWAY_MOOD_HALF_LIFE_MINUTES: mood decay half-life, 1-10080 (default 240).
# GATEWAY_PROACTIVE_ENABLED: true | false (default off). Turning it on needs
# the memory DB (GATEWAY_MEMORY_DB_PATH), a configured model and a persistent
# HMAC secret (BOTVILLE_GATEWAY_HMAC_SECRET above, kept across restarts; the
# gateway refuses to start without an explicit one). Personas opt in too.
# GATEWAY_PROACTIVE_RECENT_CONTACTS_ENABLED: false = owner only; true also
# reaches local human DM contacts from the last 7 days.
# GATEWAY_PROACTIVE_TICK_SECONDS: scheduler interval, 30-86400 (default 300).
# GATEWAY_PROACTIVE_MIN_IDLE_MINUTES: 0-43200 (default 180).
# GATEWAY_PROACTIVE_MIN_INTERVAL_MINUTES: per persona, 0-43200 (default 240).
# GATEWAY_PROACTIVE_PER_TARGET_PER_DAY: 0-24 (default 1; 0 = never send).
GATEWAY_MOOD_ENABLED=false
GATEWAY_MOOD_HALF_LIFE_MINUTES=240
GATEWAY_PROACTIVE_ENABLED=false
GATEWAY_PROACTIVE_RECENT_CONTACTS_ENABLED=false
GATEWAY_PROACTIVE_TICK_SECONDS=300
GATEWAY_PROACTIVE_MIN_IDLE_MINUTES=180
GATEWAY_PROACTIVE_MIN_INTERVAL_MINUTES=240
GATEWAY_PROACTIVE_PER_TARGET_PER_DAY=1

# Image overrides. Defaults mirror docker-compose.yml: every image is pinned
# to tag@sha256 digest (see docs/ops/upgrade-images.md before changing them).
# Overriding to :latest to track upstream is possible but not recommended.
POSTGRES_IMAGE=docker.io/library/postgres:16-alpine@sha256:0cefaabd882e42bcb2a2f3dc56d3ce4770560ba62fd7f197f1a2e008fd5731ab
SYNAPSE_IMAGE=docker.io/matrixdotorg/synapse:v1.164.1@sha256:fa4aa980f279bcf26d4e7ecc2a2c9a701c73f2ebe8841da9bdcf3b2fdf693d75
TUWUNEL_IMAGE=ghcr.io/matrix-construct/tuwunel:v1.9.4@sha256:0e86c6164d6c9f5b60291938eb61ad8395021c37fe58d47a963ea7edddbedaec
CONTINUWUITY_IMAGE=ghcr.io/continuwuity/continuwuity:v26.9.1@sha256:c9c62bc5c0a641f3f713945c701b069c7bc30d2612b54d4a5de80a5be19d5420
# sygnal is only pulled with the push profile (make up PUSH=1).
SYGNAL_IMAGE=docker.io/matrixdotorg/sygnal:v0.17.0@sha256:141f5e72fdf99a28e29ca87f3a46c19ed1cf21d5074aa3ef9df7c067e0c1c46a
