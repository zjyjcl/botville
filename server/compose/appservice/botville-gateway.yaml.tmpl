# Botville gateway appservice registration (A1.3).
#
# server/scripts/init.sh renders this file into
# server/compose/generated/appservice/botville-gateway.yaml (gitignored,
# mode 0600) by substituting $VAR-style placeholders from server/compose/.env.
# Edit this template, never the generated file.
#
# The same YAML registration format is shared by the homeservers we deploy:
#   - Synapse: listed in app_service_config_files (synapse/homeserver.yaml.tmpl,
#     mounted at /appservice, restart to apply);
#   - Tuwunel: TUWUNEL_APPSERVICE_DIR=/appservice (same file, restart to apply);
#   - continuwuity: no file-based registration yet (admin room only) — not
#     wired up, see docs/deploy/appservice.md.
#
# url: rendered by init.sh from BOTVILLE_APPSERVICE_URL, only ever `null` or
# `http://gateway:8080` (no path prefix -- the gateway serves the AS callbacks
# /_matrix/app/v1/{transactions,ping} at the root). `make up GATEWAY=1` on
# synapse/tuwunel sets http://gateway:8080; every other case (no GATEWAY=1,
# or continuwuity) is null, so the homeserver never pushes to a gateway that
# is not there (it would back off and retry forever). The homeserver reads
# this file only at startup: `make up` restarts it when the url changed.
id: botville-gateway
url: ${BOTVILLE_APPSERVICE_URL}
as_token: "${APPSERVICE_AS_TOKEN}"
hs_token: "${APPSERVICE_HS_TOKEN}"
sender_localpart: botville-gateway
rate_limited: false
namespaces:
  users:
    - exclusive: true
      # Anchored, and the server name is regex-escaped by init.sh
      # (BOTVILLE_SERVER_NAME_REGEX), so e.g. "example.com" cannot match
      # "examplexcom". Single-quoted on purpose: backslashes must survive
      # YAML parsing.
      regex: '^@ai_.*:${BOTVILLE_SERVER_NAME_REGEX}$'
  aliases:
    - exclusive: true
      # Conversation room aliases #<prefix><conversation_id>:<server>. Must
      # stay in sync with GATEWAY_ROOM_ALIAS_PREFIX on the gateway side
      # (default botville_conv_, gateway/src/botville_gateway/config.py):
      # changing the prefix means editing this regex in the same deploy, or
      # alias resolution and namespace enforcement fork. Exclusive (#107):
      # only the appservice may claim #botville_conv_* aliases — human
      # createRoom with that room_alias_name is rejected (M_EXCLUSIVE), so
      # conversation rooms are created AS-side (see docs/deploy/appservice.md).
      regex: '^#botville_conv_.*:${BOTVILLE_SERVER_NAME_REGEX}$'
