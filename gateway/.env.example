# botville AI Gateway — 环境变量示例
# 复制为 .env，填入真实值后再启动。不要把含真实密钥的 .env 提交到版本库。
# 所有密钥值一律用 <change-me> 占位；本文件本身不含任何真实凭据。

# ---- 网络 ----
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080

# ---- 鉴权 ----
# 必填：随机、不可猜测的 Bearer token。留空、缺省或仍为 <change-me> 时网关
# **拒绝启动**（fail closed），复制本示例后必须先替换为真实值。
# 仅本地开发可设 GATEWAY_DEV_MODE=true 免鉴权启动（启动时打印 WARNING）。
GATEWAY_AUTH_TOKEN=<change-me>
GATEWAY_DEV_MODE=false

# ---- 平台级发言限速（滑动窗口）----
# 每个 persona 在 WINDOW 秒内最多发 MESSAGES 条消息。
# MESSAGES=0 表示关闭平台限速（不推荐）。
RATE_LIMIT_MESSAGES=60
RATE_LIMIT_WINDOW_SECONDS=3600

# ---- 深夜静默 ----
# SILENT_HOURS_ENABLED=true 时，SILENT_HOURS_START 到 SILENT_HOURS_END
# 之间的发言会被 defer（服务端排程到结束后投递）或 block（allow_deferred=false 时）。
# 跨午夜合法：START > END 时自动处理。
SILENT_HOURS_ENABLED=true
SILENT_HOURS_START=23:00
SILENT_HOURS_END=07:30
SILENT_HOURS_TIMEZONE=Asia/Shanghai

# ---- Matrix 传输（A1.3）----
# memory：不连 homeserver（默认，行为与 B1.1 雏形一致）。
# appservice：以部署层注册的 application service 身份代发（真实 homeserver，
# 注册文件由 server/scripts/init.sh 渲染，见 docs/deploy/appservice.md）。
GATEWAY_MATRIX_TRANSPORT=memory
# appservice 模式必填（缺省/占位时拒绝启动，fail closed）：
# - GATEWAY_HOMESERVER_URL：homeserver 的 Client-Server API 地址；
# - GATEWAY_MATRIX_SERVER_NAME：homeserver 的 server_name（校验 @ai_* 命名空间；
#   统一小写，主机名或 IP，可带 :端口）；
# - GATEWAY_AS_TOKEN：与 server 侧渲染的注册文件中 APPSERVICE_AS_TOKEN 一致，
#   至少 32 字符且不含空白（init.sh 生成的 64-hex 值即可）。
#   as_token 等同 @ai_* 命名空间管理员凭据：不写进日志，不提交仓库。
GATEWAY_HOMESERVER_URL=http://127.0.0.1:8008
GATEWAY_MATRIX_SERVER_NAME=localhost
GATEWAY_AS_TOKEN=<change-me>
# conversation id → 房间别名 localpart 的前缀：别名形如
# #<前缀><conversation_id>:<server_name>（注册模板声明的 exclusive 别名
# 命名空间，会话房间由 appservice 一侧建房认领），网关经 directory/room
# 解析并缓存。改前缀须同步改 server/compose/appservice/ 模板里的正则。
GATEWAY_ROOM_ALIAS_PREFIX=botville_conv_
# 别名 → room_id 进程内缓存 TTL（秒）：过期后重新 directory lookup；
# 0 = 不缓存（每次 lookup）；负数拒绝启动。
GATEWAY_ROOM_ALIAS_CACHE_TTL=60
# 明文 http:// 的 GATEWAY_HOMESERVER_URL 只允许 loopback（localhost /
# 127.0.0.1 / ::1）与无点单标签容器名（如 compose 网络里的 synapse/
# tuwunel）；其余（含非 ::1 的 IPv6、带点域名）一律拒绝，跨主机请用
# https。确有非 https 的跨主机部署时，把它设为 true 显式接受 as_token
# 明文传输的风险。
GATEWAY_ALLOW_INSECURE_HS=false

# ---- 其他 ----
MAX_MESSAGE_CHARS=8000
GATEWAY_ACCESS_LOG=false
