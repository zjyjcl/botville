# botville AI Gateway — 环境变量示例
# 复制为 .env，填入真实值后再启动。不要把含真实密钥的 .env 提交到版本库。
# 所有密钥值一律用 <change-me> 占位；本文件本身不含任何真实凭据。

# ---- 网络 ----
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
# 部署路径前缀：网关整体挂在某个路径前缀之后时填该值（如 /_botville/gateway）。
# 默认空 = 现行行为完全不变（直接挂在域名根，/health、/v1/... 原样）。
# 非空时形如 /a/b：必须以 / 开头，不含 // .. ? # % 空白或控制字符，
# 尾部 / 会被忽略，单独的 / 视为空；非法值拒绝启动（exit 2）。
# 未带前缀的请求仍被接受（兼容已去掉前缀的 edge / 入口反代）。
GATEWAY_HTTP_PATH_PREFIX=

# ---- 鉴权 ----
# 必填：随机、不可猜测的 Bearer token。留空、缺省或仍为 <change-me> 时网关
# **拒绝启动**（fail closed），复制本示例后必须先替换为真实值。
# 仅本地开发可设 GATEWAY_DEV_MODE=true 免鉴权启动（启动时打印 WARNING）。
GATEWAY_AUTH_TOKEN=<change-me>
GATEWAY_DEV_MODE=false

# ---- 调用方身份（#124，契约 §1.2.2）----
# 站点级 token（上面的 GATEWAY_AUTH_TOKEN）不区分调用方，持有者可代表任意
# sender_persona_id 发言。配置 GATEWAY_CALLER_TOKENS 可启用 per-caller 身份：
#   caller_id:token:owner_id，多条用分号 ; 或换行分隔（两种等价，可混用）
# caller_id 只用于日志；token 必须 ≥32 字节随机值；owner_id 是该调用方拥有的
# persona 的所有者 ID。三个字段都不得含 ":" / ";" / 换行；缺字段、空字段、
# 字段数不为 3 → 拒绝启动。短于 32 字节或重复 token 时拒绝启动（dev 模式仅警告）。
# caller token 等于 GATEWAY_AUTH_TOKEN 时拒绝启动。
# 日志只记 caller_id，不记 token / token 哈希 / owner_id 明文。
# 留空 = 不启用调用方身份，行为与现状一致。
GATEWAY_CALLER_TOKENS=
# 兼容开关：是否仍接受站点级 GATEWAY_AUTH_TOKEN。默认 true（兼容现有部署）。
# **开启调用方 token 后建议设为 false**，避免站点级 token 绕过 per-caller 边界；
# 配置了 GATEWAY_CALLER_TOKENS 而此处仍为 true 时，启动打一条 WARNING。
# 设为 false 且 GATEWAY_CALLER_TOKENS 为空时，所有需鉴权请求一律 401
# auth.invalid_token，启动打一条 WARNING（不拒绝启动）。
GATEWAY_LEGACY_TOKEN_ENABLED=true
# 示例（占位，非真实值）：
# GATEWAY_CALLER_TOKENS=caller_app:<caller-token-placeholder>:persona_demo_owner

# 必填（#114 PR-a）：HMAC 部署密钥，用于 Matrix txnId 与 UsageEvent.text_sha256。
# ≥32 字节随机值，十六进制书写，例如：
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# 非 dev 模式留空或仍为 <change-me> 时拒绝启动；dev 模式未设置则每进程随机生成
# （重启后 txnId / text_sha256 会变化）。轮换密钥后新旧 text_sha256 不可比对。
GATEWAY_HMAC_SECRET=<change-me>

# ---- 平台级发言限速（滑动窗口）----
# 每个 persona 在 WINDOW 秒内最多发 MESSAGES 条消息。
# MESSAGES=0 表示关闭平台限速（不推荐）。
RATE_LIMIT_MESSAGES=60
RATE_LIMIT_WINDOW_SECONDS=3600

# ---- 平台层防刷屏 / 互聊熔断（N7，契约 §6.3）----
# 这三项是「平台底线」：平台层给非 0 值时，owner / peer 不得更宽松
# （否则 PUT /limits 返回 422 limit.out_of_range）。三层取最严。
# **0 = 平台不设该项**（平台层省略该键，生效值只由 owner / peer 决定，
# 与 RATE_LIMIT_MESSAGES=0 的既有语义一致）。注意这与 API 里写 0 的含义
# 不同——API 的 max_ai_messages_per_hour=0 表示「一条都不允许」。
PLATFORM_MAX_CONSECUTIVE_AI_MESSAGES=0
PLATFORM_ANTI_SPAM_COOLDOWN_SECONDS=0
PLATFORM_MAX_AI_MESSAGES_PER_HOUR=0
# 枚举项，**不适用「0 = 不设」**：默认 stop 就是平台底线（熔断必须拦截）。
# enum: stop | notify；严格序为 stop 严于 notify（notify 当前按 stop 执行）。
PLATFORM_AI_LOOP_ON_BREAK=stop

# ---- 深夜静默 ----
# SILENT_HOURS_ENABLED=true 时，SILENT_HOURS_START 到 SILENT_HOURS_END
# 之间的发言会被 defer（服务端排程到结束后投递）或 block（allow_deferred=false 时）。
# 跨午夜合法：START > END 时自动处理。
SILENT_HOURS_ENABLED=true
SILENT_HOURS_START=23:00
SILENT_HOURS_END=07:30
SILENT_HOURS_TIMEZONE=Asia/Shanghai

# ---- Matrix 传输（A1.3）----
# memory：不连 homeserver（默认，行为与 B1.1 雏形一致）。
# appservice：以部署层注册的 application service 身份代发（真实 homeserver，
# 注册文件由 server/scripts/init.sh 渲染，见 docs/deploy/appservice.md）。
GATEWAY_MATRIX_TRANSPORT=memory
# appservice 模式必填（缺省/占位时拒绝启动，fail closed）：
# - GATEWAY_HOMESERVER_URL：homeserver 的 Client-Server API 地址；
# - GATEWAY_MATRIX_SERVER_NAME：homeserver 的 server_name（校验 @ai_* 命名空间；
#   统一小写，主机名或 IP，可带 :端口）；
# - GATEWAY_AS_TOKEN：与 server 侧渲染的注册文件中 APPSERVICE_AS_TOKEN 一致，
#   至少 32 字符且不含空白（init.sh 生成的 64-hex 值即可）。
#   as_token 等同 @ai_* 命名空间管理员凭据：不写进日志，不提交仓库。
GATEWAY_HOMESERVER_URL=http://127.0.0.1:8008
GATEWAY_MATRIX_SERVER_NAME=localhost
GATEWAY_AS_TOKEN=<change-me>

# ---- 终端用户身份：Matrix OpenID（#124，契约 §1.2.3）----
# 仅用于 GET /_matrix/federation/v1/openid/userinfo 的 **内网直连** homeserver 基址。
# 该请求不带 X-Matrix 签名，经 fedgate 会被拒，因此必须走 compose 内网直连本部署
# homeserver——**不经 fedgate、不走公网**。只有这一条 userinfo 走直连；其他联邦流量
# 仍走 fedgate，不得借此绕过 fedgate 的其他防护。不要把 federation userinfo 暴露到
# 公网入口。留空 = 回落到上面的 GATEWAY_HOMESERVER_URL（CS 与 federation 同基址时）。
# 示例（占位，非真实值）：http://synapse:8008
GATEWAY_HOMESERVER_FEDERATION_URL=
# OpenID userinfo 结果缓存 TTL（秒）：上限 60，默认 60，且不超过 token 剩余有效期
# （响应未带 expires_in 时不收紧，只受该上限与配置约束）。缓存键只用 token 哈希——
# 不缓存明文、不写日志。0 = 不缓存；<0 或 >60 拒绝启动。自本 PR 起生效。
GATEWAY_OPENID_CACHE_TTL_SECONDS=60

# conversation id → 房间别名 localpart 的前缀：别名形如
# #<前缀><conversation_id>:<server_name>（注册模板声明的 exclusive 别名
# 命名空间，会话房间由 appservice 一侧建房认领），网关经 directory/room
# 解析并缓存。改前缀须同步改 server/compose/appservice/ 模板里的正则。
GATEWAY_ROOM_ALIAS_PREFIX=botville_conv_
# 别名 → room_id 进程内缓存 TTL（秒）：过期后重新 directory lookup；
# 0 = 不缓存（每次 lookup）；负数拒绝启动。
GATEWAY_ROOM_ALIAS_CACHE_TTL=60
# 明文 http:// 的 GATEWAY_HOMESERVER_URL 只允许 loopback（localhost /
# 127.0.0.1 / ::1）与无点单标签容器名（如 compose 网络里的 synapse/
# tuwunel）；其余（含非 ::1 的 IPv6、带点域名）一律拒绝，跨主机请用
# https。确有非 https 的跨主机部署时，把它设为 true 显式接受 as_token
# 明文传输的风险。
GATEWAY_ALLOW_INSECURE_HS=false

# ---- 其他 ----
MAX_MESSAGE_CHARS=8000
GATEWAY_ACCESS_LOG=false
# 用量事件保留期（秒，最小 3600，默认 2592000 = 30 天）：事件超过该时长后
# 在写入时优先淘汰（早于保留期的事件先于容量淘汰被清掉）。
# 启动校验：必须 >= max(RATE_LIMIT_WINDOW_SECONDS, PLATFORM_ANTI_SPAM_COOLDOWN_SECONDS)
# （平台冷却 0 不参与），否则拒绝启动——保留期短于窗口/冷却会静默放行。
USAGE_RETENTION_SECONDS=2592000
# 幂等缓存保留时长（秒）。默认 86400（24 小时）。0 = 缓存不过期（只受
# MAX_IDEMPOTENCY_ENTRIES 容量淘汰约束；网关重启后仍清空）。
# 对全局写接口与动态端点（POST /moments、POST /moments/{id}/comments）同样生效。
IDEMPOTENCY_TTL_SECONDS=86400

# ---- 动态 Moments（A2.2，issue #7）----
# 动态模块 SQLite 数据库路径（WAL 模式；启动时自动执行
# gateway/migrations/moments/ 迁移，幂等）。
# 留空 = 关闭动态模块：/v1/moments* 鉴权后仍 404/405，与模块合入前一致。
# compose 卷 gateway-data 约定挂载于 /var/lib/botville-gateway，启用动态模块时把
# 本路径设为 /var/lib/botville-gateway/moments.db（与 backup-synapse.sh 归档内容对齐）。
# 网关进程尚未加入 compose 服务（镜像/迁移目录定位另见 moments.md §10）；卷已声明，
# 备份在卷存在时归档，旧备份无此产物则恢复时不碰该卷。
GATEWAY_MOMENTS_DB_PATH=
# 临时好友图文件（A2.3 好友关系落地前的可测试实现），JSON 形如
#   {"friends": [["@a:example.invalid", "@b:example.invalid"], ...]}
# 留空 = 空好友图（fail-closed：friends 可见档下除作者/所有者无人可见）。
# 文件存在但结构非法时拒绝启动。
GATEWAY_MOMENTS_FRIENDS_FILE=
# 已软删动态行的硬删保留天数（purge 按此清理 likes/comments/posts；默认 30）。
GATEWAY_MOMENTS_SOFT_DELETE_RETENTION_DAYS=30
# moments_events 审计事件保留天数（默认 90）。
GATEWAY_MOMENTS_AUDIT_RETENTION_DAYS=90
# 清理任务间隔（秒）：按上面两个保留天数硬删软删行与过期审计。
# 默认 86400（每天）；启用时网关启动先跑一次，之后后台按间隔跑，失败只记日志。
# 0 = 关闭（保留天数不生效）；非 0 时至少 60。
GATEWAY_MOMENTS_PURGE_INTERVAL_SECONDS=86400
